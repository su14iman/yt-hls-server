# Copy to .env and adjust. Every value below is a default, so an empty file works.

# ---- server ----
PORT=8000
LOG_LEVEL=info
# Only enable behind a reverse proxy you control: otherwise a client can spoof
# X-Forwarded-For and evade the rate limiter.
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=10000

# ---- input policy ----
# Comma-separated hostnames that may be extracted. This is what prevents the
# server from being used as an open SSRF proxy. An empty value disables the
# check entirely - only do that on a private network.
ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,youtu.be,www.youtu.be,music.youtube.com

# Optional shared secret for the extraction endpoints. Accepted as
# "Authorization: Bearer <token>" or as ?token=<token>. The health endpoints
# stay open so container probes keep working.
# API_TOKEN=

# ---- yt-dlp ----
# Leave unset to auto-detect /usr/local/bin/yt-dlp, /usr/bin/yt-dlp, then PATH.
# YTDLP_PATH=/usr/local/bin/yt-dlp
YTDLP_TIMEOUT_MS=25000
YTDLP_SOCKET_TIMEOUT=15
YTDLP_RETRIES=2

# Simultaneous yt-dlp processes. Requests beyond this queue, and are rejected
# with 503 once the queue is full.
YTDLP_CONCURRENCY=3
YTDLP_QUEUE_LIMIT=50

# Self-update yt-dlp on start. Needs a writable binary, so it is incompatible
# with a read-only container filesystem.
YTDLP_AUTO_UPDATE=0

# Set these once YouTube starts demanding sign-in from this IP address.
# YTDLP_COOKIES=/run/secrets/cookies.txt
# YTDLP_PROXY=socks5://user:pass@host:1080
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=default,web_safari

# ---- cache ----
# Fallback TTL, used only when the resolved URL carries no expiry of its own.
CACHE_TTL_MS=240000
CACHE_MAX_TTL_MS=10800000
# Stop serving a cached URL this long before it actually expires.
CACHE_EXPIRY_MARGIN_MS=60000
CACHE_MAX_ENTRIES=500

# ---- rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
# 0 disables the limiter.
RATE_LIMIT_MAX=60
